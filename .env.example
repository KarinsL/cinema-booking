# =====================================================================
# FILE MẪU CẤU HÌNH (được commit lên GitHub, KHÔNG chứa mật khẩu thật)
# Tạo file .env thật bằng lệnh:   ./scripts/gen-secrets.sh
# Script thay mọi giá trị CHANGE_ME bằng mật khẩu ngẫu nhiên 22 ký tự
# (có chữ hoa, chữ thường, số, ký tự đặc biệt). File .env nằm trong .gitignore.
# =====================================================================
TZ=Asia/Ho_Chi_Minh

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=cinema_db
# Tài khoản website: chỉ SELECT, INSERT, UPDATE
APP_DB_USER=cinema_app
APP_DB_PASSWORD=CHANGE_ME
# Tài khoản quản trị CSDL dùng trong phpMyAdmin: toàn quyền nhưng chỉ trên cinema_db
DBA_DB_USER=cinema_dba
DBA_DB_PASSWORD=CHANGE_ME
# Tài khoản chỉ đọc (báo cáo)
REPORT_DB_USER=cinema_report
REPORT_DB_PASSWORD=CHANGE_ME
# Tài khoản cho mysqld-exporter (Prometheus, dùng từ giai đoạn 2)
EXPORTER_DB_USER=cinema_exporter
EXPORTER_DB_PASSWORD=CHANGE_ME

# ---------------- Website đặt vé ----------------
APP_ADMIN_EMAIL=admin@cinema.local
APP_ADMIN_PASSWORD=CHANGE_ME
# true: tạo sẵn vài đơn mẫu để trang quản trị và Grafana có số liệu
APP_SEED_DEMO=true

# ---------------- Basic Auth bảo vệ phpMyAdmin và Prometheus ----------------
TOOLS_BASIC_AUTH_USER=opsadmin
TOOLS_BASIC_AUTH_PASSWORD=CHANGE_ME

# ---------------- Grafana (dùng từ giai đoạn 2) ----------------
GRAFANA_ADMIN_USER=grafadmin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
